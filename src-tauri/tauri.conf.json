{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mem Reduct",
  "version": "3.5.19",
  "identifier": "com.memreduct.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mem Reduct",
        "width": 400,
        "height": 700,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRkNDQ0ZDOUQyNzY4RDUKUldUVmFDZWQvTXo4TXZtODdQQUNBTTk4WXFQK1pLZkZIWVk0aGJkSStRbnBWQUo1d21uSTRQOEcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "memreduct",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "Russian",
          "Italian",
          "PortugueseBR",
          "Turkish",
          "Polish",
          "Vietnamese",
          "Thai",
          "Indonesian"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Polish": "nsis-lang/Polish.nsh",
          "Vietnamese": "nsis-lang/Vietnamese.nsh",
          "Thai": "nsis-lang/Thai.nsh",
          "Indonesian": "nsis-lang/Indonesian.nsh"
        },
        "installerHooks": "nsis-lang/hooks.nsh"
      }
    }
  }
}
